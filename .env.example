# Browser-safe Supabase configuration. These values are embedded in the Vite bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only configuration for Vercel Functions. Never prefix secrets with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Reserved for future source integrations. They are not used by the browser app.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
